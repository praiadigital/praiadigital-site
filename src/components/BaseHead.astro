---
const {
  site,
  title,
  description,
  image,
  canonical,
  noindex = false,
  publishedTime,
  modifiedTime
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImage = image ?? `${site}/img/og-default.png`;
const ogImageAlt = 'Praia Digital – IA que gera leads e vendas para imobiliárias no litoral';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0ea5e9" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Praia Digital" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: "Praia Digital",
      description,
      url: site,
      image: ogImage,
      areaServed: [
        { "@type": "City", name: "Ubatuba" },
        { "@type": "City", name: "Caraguatatuba" },
        { "@type": "City", name: "São Sebastião" },
        { "@type": "City", name: "Ilhabela" }
      ],
      priceRange: "R$",
      telephone: "+55-11-95434-6288",
      email: "comercial@praia.digital"
    })} />

    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <slot name="head" />
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <slot />
  </body>
</html>
