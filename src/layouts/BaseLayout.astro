---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const props = Astro.props;

const title = props.title
  ? `${props.title} | PraiaDigital`
  : 'PraiaDigital — Inbound Marketing para imóveis no litoral';

const description = props.description ?? 'Gestão de aluguel temporada, zeladoria, manutenção e assessoria imobiliária no litoral norte de São Paulo.';
---

<BaseHead
  site="https://praia.digital"
  title={title}
  description={description}
  image={props.image}
  canonical={props.canonical}
  noindex={props.noindex}
/>

<a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">
  Pular para o conteúdo
</a>

<div class="flex min-h-screen flex-col">
  <Header />

  <main id="conteudo" class="flex-1">
    <slot />
  </main>

  <Footer />
</div>
