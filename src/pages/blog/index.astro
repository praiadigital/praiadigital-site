---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    href: '/blog/calendario-alta-temporada-litoral',
    tag: 'Planejamento',
    title: 'Calendário de preparação para a alta temporada',
    text: 'O que fazer mês a mês para chegar pronto ao verão.',
    date: '2026-09-15',
    dateLabel: '15 set 2026',
  },
  {
    href: '/blog/ia-para-corretores-litoral',
    tag: 'Inteligência artificial',
    title: 'IA para corretores do litoral: por onde começar',
    text: 'Atendimento, conteúdo e follow-up com IA — sem perder o toque humano.',
    date: '2026-09-14',
    dateLabel: '14 set 2026',
  },
  {
    href: '/blog/palavras-chave-seo-litoral',
    tag: 'SEO',
    title: 'Palavras-chave para o litoral',
    text: 'As intenções de busca que geram reservas e vendas no litoral norte.',
    date: '2026-09-12',
    dateLabel: '12 set 2026',
  },
  {
    href: '/blog/fotos-que-vendem-mais',
    tag: 'Marketing',
    title: 'Fotos que vendem mais',
    text: 'Direção de arte simples para anúncios de temporada que convertem.',
    date: '2026-09-10',
    dateLabel: '10 set 2026',
  },
  {
    href: '/blog/como-preparar-imovel-temporada',
    tag: 'Guia',
    title: 'Como preparar o imóvel para temporada',
    text: 'Checklist completo: limpeza, manutenção, enxoval e apresentação.',
    date: '2026-09-08',
    dateLabel: '8 set 2026',
  },
  {
    href: '/blog/cases',
    tag: 'Resultados',
    title: 'Cases e resultados',
    text: 'Números reais de clientes PraiaDigital no litoral norte de SP.',
    date: '2026-09-05',
    dateLabel: '5 set 2026',
  },
];
---

<BaseLayout title="Blog" description="Guias e conteúdos sobre aluguel temporada, imóveis no litoral norte de SP, SEO local e inbound marketing imobiliário.">
  <section class="border-b border-slate-200">
    <div class="container py-16">
      <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>
      <p class="mt-4 max-w-2xl text-slate-600">Guias, materiais e ideias para proprietários e corretores do litoral. Assine o <a href="/rss.xml" class="text-brand-600 underline hover:text-brand-700">feed RSS</a>.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {posts.map((post) => (
          <a href={post.href} class="rounded-xl border border-slate-200 p-6 hover:border-slate-300">
            <div class="flex items-center justify-between gap-2">
              <p class="text-sm font-semibold text-brand-600">{post.tag}</p>
              <time datetime={post.date} class="text-xs text-slate-400">{post.dateLabel}</time>
            </div>
            <h2 class="mt-2 text-lg font-semibold">{post.title}</h2>
            <p class="mt-2 text-sm text-slate-600">{post.text}</p>
            <p class="mt-3 text-sm font-semibold text-brand-600">Ler o conteúdo →</p>
          </a>
        ))}
      </div>

      <div class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-6">
        <h2 class="text-lg font-semibold">Ferramentas de IA para corretores</h2>
        <p class="mt-2 text-sm text-slate-600">Prompts, scripts e automações organizados por cidade no nosso hub.</p>
        <a href="/hub/ia-corretores-litoral.html" class="mt-3 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">Acessar o hub de IA →</a>
      </div>
    </div>
  </section>
</BaseLayout>
