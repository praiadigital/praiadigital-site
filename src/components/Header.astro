---
const base = import.meta.env.BASE_URL; // e.g. '/praiadigital-site/'
const whatsappNumber = import.meta.env.WHATSAPP_NUMBER ?? '5511954346288';
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
const pathname = Astro.url.pathname;

const u = (path: string) => `${base}${path.replace(/^\//, '')}`;

// Estrutura única de navegação, agrupada por seção
const menuGroups = [
  {
    title: 'Quero Investir',
    links: [
      { href: u('/servicos/gestao-aluguel-temporada/'), label: 'Gestão de aluguel de temporada' },
      { href: u('/blog/calendario-alta-temporada-litoral'), label: 'Calendário de alta temporada' },
      { href: u('/contato/'), label: 'Simulação de rentabilidade' },
    ],
  },
  {
    title: 'Quero Comprar',
    links: [
      { href: u('/servicos/assessoria-imobiliaria/'), label: 'Assessoria imobiliária' },
      { href: u('/blog/palavras-chave-seo-litoral'), label: 'Mercado por cidade' },
      { href: u('/faq/'), label: 'Dúvidas frequentes' },
    ],
  },
  {
    title: 'Sou Corretor',
    links: [
      { href: u('/hub/ia-corretores-litoral.html'), label: 'Hub de IA para corretores' },
      { href: u('/blog/ia-para-corretores-litoral'), label: 'IA na prática' },
      { href: u('/contato/'), label: 'Parcerias' },
    ],
  },
  {
    title: 'Navegação',
    links: [
      { href: u('/sobre/'), label: 'Sobre' },
      { href: u('/servicos/'), label: 'Serviços' },
      { href: u('/blog/'), label: 'Conteúdos' },
      { href: u('/faq/'), label: 'FAQ' },
      { href: u('/contato/'), label: 'Contato' },
    ],
  },
];

function isActive(href: string): boolean {
  const path = href.replace(base, '/');
  if (path.startsWith('/blog')) return pathname.includes('/blog');
  if (path.startsWith('/servicos')) return pathname.includes('/servicos');
  if (path.includes('/hub/')) return pathname.includes('/hub') || pathname.includes('/cidades');
  return pathname.endsWith(path);
}
---

<!-- Cabeçalho fixo e enxuto (altura fixa de 80px) -->
<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur">
  <div class="container flex h-20 items-center justify-between gap-4">
    <!-- Logo (renderizada uma única vez) -->
    <a href={base} class="flex items-center gap-2 text-lg font-semibold text-brand-600" aria-label="PraiaDigital — página inicial">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-brand-600 text-white" aria-hidden="true">P</span>
      <span>PraiaDigital</span>
    </a>

    <div class="flex items-center gap-3">
      <!-- CTA à direita -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-md bg-litoral-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-litoral-500"
      >
        Fale conosco
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.6-5.2A8.38 8.38 0 0 1 3.5 11.5a8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/></svg>
      </a>

      <!-- Botão único de menu (desktop e mobile) -->
      <div class="relative" id="site-menu">
        <button
          type="button"
          id="site-menu-button"
          class="inline-flex items-center gap-2 rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-brand-600"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="site-menu-panel"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          Menu
        </button>

        <!-- Painel dropdown: OCULTO por padrão, abre apenas ao clicar no botão -->
        <div
          id="site-menu-panel"
          class="absolute right-0 top-12 hidden max-h-[calc(100vh-7rem)] w-80 overflow-y-auto rounded-xl border border-slate-200 bg-white p-4 shadow-lg"
          role="menu"
          aria-label="Menu do site"
        >
          {menuGroups.map((group, gi) => (
            <div class={gi > 0 ? 'mt-3 border-t border-slate-200 pt-3' : ''}>
              <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">{group.title}</p>
              <ul class="space-y-1 text-sm font-medium text-slate-700">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      role="menuitem"
                      class:list={['block rounded-md px-3 py-2 hover:bg-slate-50', isActive(link.href) ? 'text-brand-600' : 'hover:text-brand-600']}
                      aria-current={isActive(link.href) ? 'page' : undefined}
                    >{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const wrapper = document.getElementById('site-menu');
  const button = document.getElementById('site-menu-button');
  const panel = document.getElementById('site-menu-panel');

  function setMenu(open: boolean) {
    if (!panel || !button) return;
    panel.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
  }

  // Abre/fecha ao clicar no botão
  button?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenu(panel?.classList.contains('hidden') ?? false);
  });

  // Fecha ao clicar fora do menu
  document.addEventListener('click', (e) => {
    if (wrapper && !wrapper.contains(e.target as Node)) setMenu(false);
  });

  // Fecha com Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  // Fecha ao clicar em um link (navegação)
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
</script>
