---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { cidades, cidadePorSlug } from '../../data/cidades.ts';

export function getStaticPaths() {
  return cidades.map((c) => ({ params: { cidade: c.slug } }));
}

const slug = Astro.params.cidade as string;
const cidade = cidadePorSlug(slug)!;
const canonical = `https://praia.digital/hub/${cidade.slug}.html`;

const outrasCidades = cidades.filter((c) => c.slug !== cidade.slug);
---

<BaseLayout title={cidade.metaTitle} description={cidade.metaDescription} canonical={canonical}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    name: `IA para corretores e imobiliárias em ${cidade.nome}`,
    provider: { "@type": "ProfessionalService", name: "PraiaDigital", url: "https://praia.digital" },
    areaServed: { "@type": "City", name: cidade.nome },
    description: cidade.metaDescription
  })} />

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container py-16 md:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-brand-600">Litoral {cidade.regiao} de São Paulo</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">
          IA para corretores e imobiliárias em {cidade.nome}
        </h1>
        <p class="mt-4 text-lg text-slate-600">{cidade.metaDescription}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://wa.me/5511954346288" target="_blank" rel="noopener" class="rounded-md bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow hover:bg-brand-700">Quero mais leads em {cidade.nome}</a>
          <a href="/hub/ia-corretores-litoral.html" class="rounded-md border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:border-slate-400">Ver o hub completo</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <h2 class="text-2xl font-semibold">O que você encontra para {cidade.nome}</h2>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
        <article class="rounded-xl border border-slate-200 p-6">
          <h3 class="text-base font-semibold">Atendimento com IA</h3>
          <p class="mt-2 text-sm text-slate-600">Scripts e fluxos de WhatsApp treinados para o mercado de {cidade.nome}: temporada, venda e captação de proprietários.</p>
        </article>
        <article class="rounded-xl border border-slate-200 p-6">
          <h3 class="text-base font-semibold">Conteúdo local</h3>
          <p class="mt-2 text-sm text-slate-600">Prompts e pautas com intenção de busca real de quem procura imóvel em {cidade.nome}.</p>
        </article>
        <article class="rounded-xl border border-slate-200 p-6">
          <h3 class="text-base font-semibold">Conversão</h3>
          <p class="mt-2 text-sm text-slate-600">Follow-up automatizado e modelos de proposta para fechar mais rápido em {cidade.nome}.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="container py-12">
      <h2 class="text-xl font-semibold">Serviços em {cidade.nome}</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        <a href="/servicos/gestao-aluguel-temporada" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Gestão de temporada</p>
          <p class="mt-1 text-sm text-slate-600">Mais reservas para imóveis em {cidade.nome} o ano todo.</p>
        </a>
        <a href="/servicos/zeladoria-manutencao" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Zeladoria e manutenção</p>
          <p class="mt-1 text-sm text-slate-600">Inspeções e suporte local em {cidade.nome}.</p>
        </a>
        <a href="/servicos/assessoria-imobiliaria" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Assessoria imobiliária</p>
          <p class="mt-1 text-sm text-slate-600">Venda com segurança no mercado de {cidade.nome}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200">
    <div class="container py-12">
      <h2 class="text-xl font-semibold">Outras cidades do litoral norte</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        {outrasCidades.map((c) => (
          <a href={`/hub/${c.slug}.html`} class="rounded-xl border border-slate-200 p-5 hover:border-slate-300">
            <p class="text-sm font-semibold text-brand-600">Litoral {c.regiao}</p>
            <p class="mt-1 text-base font-semibold text-slate-900">{c.nome}</p>
            <p class="mt-2 text-sm text-slate-600">IA e conteúdo para corretores em {c.nome}.</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200">
    <div class="container py-16">
      <LeadForm />
    </div>
  </section>
</BaseLayout>
