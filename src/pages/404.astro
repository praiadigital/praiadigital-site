---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { href: '/', label: 'Página inicial', text: 'Visão geral da PraiaDigital e resultados.' },
  { href: '/servicos', label: 'Serviços', text: 'Gestão de temporada, assessoria e zeladoria.' },
  { href: '/blog', label: 'Blog', text: 'Guias para proprietários e corretores do litoral.' },
  { href: '/hub/ia-corretores-litoral.html', label: 'Hub de IA', text: 'Ferramentas de IA para corretores.' },
  { href: '/contato', label: 'Contato', text: 'Fale com a gente pelo WhatsApp ou formulário.' },
];
---

<BaseLayout title="Página não encontrada" description="A página que você procura não existe ou foi movida." noindex>
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-brand-600">Erro 404</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">Página não encontrada</h1>
        <p class="mt-4 text-lg text-slate-600">
          O endereço que você acessou não existe ou foi movido. Escolha um dos caminhos abaixo para continuar navegando:
        </p>
      </div>

      <nav class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3" aria-label="Páginas principais">
        {links.map((link) => (
          <a href={link.href} class="rounded-xl border border-slate-200 p-5 hover:border-slate-300">
            <p class="text-base font-semibold text-slate-900">{link.label}</p>
            <p class="mt-1 text-sm text-slate-600">{link.text}</p>
          </a>
        ))}
      </nav>
    </div>
  </section>
</BaseLayout>
