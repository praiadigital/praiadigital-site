---
const whatsappNumber = import.meta.env.WHATSAPP_NUMBER ?? '5511954346288';
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
const formTitle = 'Receba um diagnóstico gratuito do seu imóvel';
const formSubtitle = 'Em até 1 dia útil, um especialista analisa seu caso e responde no seu WhatsApp. Sem compromisso.';
---

<section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm md:p-8">
  <div class="max-w-2xl">
    <h2 class="text-2xl font-semibold tracking-tight">{formTitle}</h2>
    <p class="mt-2 text-slate-600">{formSubtitle}</p>

    <form
      id="pd-lead-form"
      data-whatsapp={whatsappUrl}
      class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2"
    >
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700" for="pd-name">Nome</label>
        <input id="pd-name" name="name" type="text" autocomplete="name" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none" placeholder="Seu nome completo" />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700" for="pd-phone">WhatsApp</label>
        <input id="pd-phone" name="phone" type="tel" autocomplete="tel" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none" placeholder="(11) 99999-9999" />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700" for="pd-email">E-mail</label>
        <input id="pd-email" name="email" type="email" autocomplete="email" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none" placeholder="voce@exemplo.com" />
      </div>

      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700" for="pd-msg">Mensagem</label>
        <textarea id="pd-msg" name="message" rows="3" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none" placeholder="Conte brevemente sobre o imóvel ou objetivo"></textarea>
      </div>

      <div class="md:col-span-2">
        <p class="text-xs text-slate-500">
          Ao enviar, você concorda com nossa <a href="/privacidade" class="underline">Política de Privacidade</a> e autoriza o contato por WhatsApp/e-mail.
        </p>
      </div>

      <div class="md:col-span-2">
        <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow hover:bg-brand-700 md:w-auto">
          Quero meu diagnóstico gratuito
        </button>
        <p id="pd-form-hint" class="mt-2 hidden text-sm text-brand-600">Abrindo o WhatsApp com sua mensagem…</p>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('pd-lead-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form as HTMLFormElement);
    const name = String(data.get('name') || '').trim();
    const phone = String(data.get('phone') || '').trim();
    const email = String(data.get('email') || '').trim();
    const message = String(data.get('message') || '').trim();

    const lines = [
      `Olá! Sou ${name} e quero um diagnóstico gratuito do meu imóvel.`,
      phone && `Meu WhatsApp: ${phone}`,
      email && `Meu e-mail: ${email}`,
      message && `Sobre o imóvel: ${message}`,
    ].filter(Boolean);

    const url = `${form.getAttribute('data-whatsapp')}?text=${encodeURIComponent(lines.join('\n'))}`;
    document.getElementById('pd-form-hint')?.classList.remove('hidden');
    window.open(url, '_blank', 'noopener');
  });
</script>
