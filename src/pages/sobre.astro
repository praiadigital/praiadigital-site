---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';

const servicos = [
  { href: '/servicos/gestao-aluguel-temporada', title: 'Gestão de aluguel por temporada', text: 'Receita o ano todo com operação completa de reservas e hóspedes.' },
  { href: '/servicos/zeladoria-manutencao', title: 'Zeladoria e manutenção', text: 'Inspeções, preventiva e atendimento emergencial local.' },
  { href: '/servicos/assessoria-imobiliaria', title: 'Assessoria imobiliária', text: 'Avaliação, documentação e negociação para vender com segurança.' },
];

const valores = [
  { title: 'Conhecimento local', text: 'Nascemos no litoral e conhecemos o ritmo do mercado: alta temporada em janeiro, imóvel fechado em julho, proprietário que mora longe.' },
  { title: 'Dados, não achismo', text: 'SEO local, copy para imóveis e automação de follow-up — sempre com abordagem enxuta e baseada em números.' },
  { title: 'Operação completa', text: 'Marketing com IA, gestão de temporada e zeladoria local em um único parceiro, para o imóvel render o ano todo.' },
];
---

<BaseLayout title="Sobre a PraiaDigital — inbound marketing e gestão de imóveis no litoral" description="Conheça a PraiaDigital: estratégia de inbound marketing, IA e gestão de imóveis para o litoral norte de São Paulo. SEO local, conteúdo e conversão.">
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50 to-white">
    <div class="container py-16">
      <p class="eyebrow">Quem somos</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Sobre a PraiaDigital</h1>
      <p class="mt-4 max-w-2xl text-slate-600">
        PraiaDigital é uma operação focada em inbound marketing e gestão de imóveis no litoral norte de São Paulo. Ajudamos proprietários e imobiliárias a criar conteúdo, estruturar ofertas e gerar leads qualificados.
      </p>
    </div>
  </section>

  <section class="border-b border-slate-200 py-16">
    <div class="container">
      <h2 class="text-2xl font-semibold">Como trabalhamos</h2>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
        {valores.map((v) => (
          <article class="card">
            <h3 class="text-base font-semibold">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{v.text}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 max-w-3xl space-y-4 text-slate-600">
        <p>Unimos três frentes — marketing com IA, <a href="/servicos/gestao-aluguel-temporada" class="text-brand-600 underline hover:text-brand-700">gestão de temporada</a> e <a href="/servicos/zeladoria-manutencao" class="text-brand-600 underline hover:text-brand-700">zeladoria local</a> — para seu imóvel render o ano todo, sem você se preocupar.</p>
        <p>Veja <a href="/blog/cases" class="text-brand-600 underline hover:text-brand-700">cases reais de resultados</a> ou conheça nossa <a href="/servicos/assessoria-imobiliaria" class="text-brand-600 underline hover:text-brand-700">assessoria imobiliária</a>.</p>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container py-16">
      <h2 class="text-xl font-semibold">Conheça nossos serviços</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        {servicos.map((s) => (
          <a href={s.href} class="card card-hover no-underline hover:no-underline">
            <p class="text-sm font-semibold text-slate-900">{s.title}</p>
            <p class="mt-1 text-sm text-slate-600">{s.text}</p>
            <p class="mt-3 text-sm font-semibold text-brand-600">Saiba mais →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container py-16">
      <LeadForm />
    </div>
  </section>
</BaseLayout>
