---
const base = import.meta.env.BASE_URL; // e.g. '/praiadigital-site/'
const whatsappNumber = import.meta.env.WHATSAPP_NUMBER ?? '5511954346288';
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
const pathname = Astro.url.pathname;

const u = (path: string) => `${base}${path.replace(/^\//, '')}`;

const servicos = [
  { href: u('/servicos/gestao-aluguel-temporada/'), label: 'Gestão de aluguel temporada' },
  { href: u('/servicos/assessoria-imobiliaria/'), label: 'Assessoria imobiliária' },
  { href: u('/servicos/zeladoria-manutencao/'), label: 'Zeladoria e manutenção' },
];

// Categorias do mega menu (oculto por padrão; abre no hover/focus/clique)
const megaMenus = [
  {
    label: 'Quero Investir',
    links: [
      { href: u('/servicos/gestao-aluguel-temporada/'), label: 'Gestão de aluguel de temporada', desc: 'Renda com seu imóvel no litoral' },
      { href: u('/blog/calendario-alta-temporada-litoral'), label: 'Calendário de alta temporada', desc: 'Planeje a temporada com antecedência' },
      { href: u('/contato/'), label: 'Falar com especialista', desc: 'Simulação de rentabilidade' },
    ],
  },
  {
    label: 'Quero Comprar',
    links: [
      { href: u('/servicos/assessoria-imobiliaria/'), label: 'Assessoria imobiliária', desc: 'Compra assistida no litoral norte' },
      { href: u('/blog/palavras-chave-seo-litoral'), label: 'Mercado por cidade', desc: 'Onde investir no litoral de SP' },
      { href: u('/faq/'), label: 'Dúvidas frequentes', desc: 'Tudo sobre compra no litoral' },
    ],
  },
  {
    label: 'Sou Corretor',
    links: [
      { href: u('/hub/ia-corretores-litoral.html'), label: 'Hub de IA para corretores', desc: 'Atendimento e follow-up com IA' },
      { href: u('/blog/ia-para-corretores-litoral'), label: 'IA na prática', desc: 'Cases e guias para corretores' },
      { href: u('/contato/'), label: 'Parcerias', desc: 'Trabalhe com a PraiaDigital' },
    ],
  },
];

const navLinks = [
  { href: u('/sobre/'), label: 'Sobre' },
  { href: u('/servicos/'), label: 'Serviços' },
  { href: u('/hub/ia-corretores-litoral.html'), label: 'Hub IA' },
  { href: u('/blog/'), label: 'Conteúdos' },
  { href: u('/faq/'), label: 'FAQ' },
  { href: u('/contato/'), label: 'Contato' },
];

function isActive(href: string): boolean {
  const path = href.replace(base, '/');
  if (path.startsWith('/blog')) return pathname.includes('/blog');
  if (path.startsWith('/servicos')) return pathname.includes('/servicos');
  if (path.includes('/hub/')) return pathname.includes('/hub') || pathname.includes('/cidades');
  return pathname.endsWith(path);
}
---

<!-- Cabeçalho fixo e enxuto (altura fixa de 80px) -->
<header class="site-header sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur">
  <div class="container flex h-20 items-center justify-between gap-4">
    <!-- Logo (renderizada uma única vez) -->
    <a href={base} class="flex items-center gap-2 text-lg font-semibold text-brand-600" aria-label="PraiaDigital — página inicial">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-brand-600 text-white" aria-hidden="true">P</span>
      <span>PraiaDigital</span>
    </a>

    <!-- Navegação desktop com mega menu -->
    <nav class="hidden items-center gap-1 text-sm font-medium text-slate-600 lg:flex" aria-label="Navegação principal">
      {megaMenus.map((menu) => (
        <div class="mega-item group relative">
          <button
            type="button"
            class="rounded-md px-3 py-2 hover:text-brand-600"
            aria-haspopup="true"
            aria-expanded="false"
          >
            {menu.label}
            <svg class="ml-1 inline h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <!-- Mega menu: OCULTO por padrão, abre no hover/focus do item-pai -->
          <div class="mega-menu invisible absolute left-1/2 top-full z-50 w-[28rem] -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-lg">
              <ul class="space-y-1">
                {menu.links.map((l) => (
                  <li>
                    <a href={l.href} class="block rounded-md px-3 py-2 hover:bg-slate-50">
                      <span class="block text-sm font-semibold text-slate-900">{l.label}</span>
                      <span class="block text-xs text-slate-500">{l.desc}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}

      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['rounded-md px-3 py-2', isActive(link.href) ? 'text-brand-600' : 'hover:text-brand-600']}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >{link.label}</a>
      ))}
    </nav>

    <!-- CTA à direita -->
    <div class="flex items-center gap-3">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-md bg-litoral-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-litoral-500"
      >
        Fale conosco
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.6-5.2A8.38 8.38 0 0 1 3.5 11.5a8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/></svg>
      </a>

      <!-- Hambúrguer (mobile) -->
      <details class="relative lg:hidden" id="mobile-menu">
        <summary class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-slate-300 text-slate-700 hover:border-slate-400" aria-label="Abrir menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </summary>
        <nav class="absolute right-0 top-12 max-h-[calc(100vh-6rem)] w-72 overflow-y-auto rounded-xl border border-slate-200 bg-white p-4 shadow-lg" aria-label="Menu móvel">
          <ul class="space-y-1 text-sm font-medium text-slate-700">
            {megaMenus.map((menu) => (
              <li>
                <details class="mobile-sub">
                  <summary class="cursor-pointer list-none rounded-md px-3 py-2 font-semibold text-slate-900 hover:bg-slate-50">{menu.label}</summary>
                  <ul class="space-y-1 pb-2 pl-3">
                    {menu.links.map((l) => (
                      <li><a href={l.href} class="block rounded-md px-3 py-2 hover:bg-slate-50 hover:text-brand-600">{l.label}</a></li>
                    ))}
                  </ul>
                </details>
              </li>
            ))}
            <li class="border-t border-slate-200 pt-2 mt-2"></li>
            {navLinks.map((link) => (
              <li><a href={link.href} class="block rounded-md px-3 py-2 hover:bg-slate-50 hover:text-brand-600" aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
            ))}
            <li class="border-t border-slate-200 pt-2 mt-2"><p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Serviços</p></li>
            {servicos.map((s) => (
              <li><a href={s.href} class="block rounded-md px-3 py-2 hover:bg-slate-50 hover:text-brand-600">{s.label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* Reforço: mega menu sempre oculto por padrão */
  .mega-menu {
    display: none;
  }
  .mega-item:hover .mega-menu,
  .mega-item:focus-within .mega-menu {
    display: block;
  }
  /* Remove marcador padrão dos <summary> */
  summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Atualiza aria-expanded nos triggers do mega menu (desktop)
  document.querySelectorAll('.mega-item').forEach((item) => {
    const btn = item.querySelector('button');
    const set = (v: boolean) => btn?.setAttribute('aria-expanded', String(v));
    item.addEventListener('mouseenter', () => set(true));
    item.addEventListener('mouseleave', () => set(false));
    item.addEventListener('focusin', () => set(true));
    item.addEventListener('focusout', () => set(false));
  });

  // Fecha o menu mobile ao clicar fora ou navegar
  const mobile = document.getElementById('mobile-menu') as HTMLDetailsElement | null;
  document.addEventListener('click', (e) => {
    if (mobile?.open && !mobile.contains(e.target as Node)) mobile.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobile?.open) mobile.open = false;
  });
</script>
