---
const year = new Date().getFullYear();
const whatsappNumber = import.meta.env.WHATSAPP_NUMBER ?? '5511954346288';
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="container py-12">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-2 font-semibold text-slate-900 no-underline hover:no-underline">
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-brand-600 text-sm text-white" aria-hidden="true">P</span>
          Praia<span class="text-brand-600">Digital</span>
        </a>
        <p class="mt-3 text-sm text-slate-600">
          Inbound Marketing para imóveis no litoral norte de São Paulo.
        </p>
        <p class="mt-4 text-sm text-slate-600">
          E-mail: <a href="mailto:comercial@praia.digital" class="underline">comercial@praia.digital</a><br />
          WhatsApp: <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener" class="underline">+55 11 95434-6288</a>
        </p>
      </div>

      <nav aria-label="Serviços">
        <p class="font-semibold text-slate-900">Serviços</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li><a href="/servicos" class="no-underline hover:text-brand-600">Todos os serviços</a></li>
          <li><a href="/servicos/gestao-aluguel-temporada" class="no-underline hover:text-brand-600">Gestão de aluguel temporada</a></li>
          <li><a href="/servicos/zeladoria-manutencao" class="no-underline hover:text-brand-600">Zeladoria e manutenção</a></li>
          <li><a href="/servicos/assessoria-imobiliaria" class="no-underline hover:text-brand-600">Assessoria imobiliária</a></li>
        </ul>
      </nav>

      <nav aria-label="Conteúdos e recursos">
        <p class="font-semibold text-slate-900">Conteúdos</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li><a href="/blog" class="no-underline hover:text-brand-600">Blog</a></li>
          <li><a href="/blog/como-preparar-imovel-temporada" class="no-underline hover:text-brand-600">Preparar o imóvel para temporada</a></li>
          <li><a href="/blog/fotos-que-vendem-mais" class="no-underline hover:text-brand-600">Fotos que vendem mais</a></li>
          <li><a href="/blog/palavras-chave-seo-litoral" class="no-underline hover:text-brand-600">Palavras-chave para o litoral</a></li>
          <li><a href="/blog/ia-para-corretores-litoral" class="no-underline hover:text-brand-600">IA para corretores</a></li>
          <li><a href="/hub/ia-corretores-litoral.html" class="no-underline hover:text-brand-600">Hub de IA para corretores</a></li>
          <li><a href="/blog/cases" class="no-underline hover:text-brand-600">Cases</a></li>
        </ul>
      </nav>

      <nav aria-label="Institucional">
        <p class="font-semibold text-slate-900">Institucional</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li><a href="/sobre" class="no-underline hover:text-brand-600">Sobre</a></li>
          <li><a href="/faq" class="no-underline hover:text-brand-600">FAQ</a></li>
          <li><a href="/contato" class="no-underline hover:text-brand-600">Contato</a></li>
          <li><a href="/privacidade" class="no-underline hover:text-brand-600">Política de Privacidade</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-slate-200 pt-6 md:flex-row md:items-center md:justify-between">
      <p class="text-sm text-slate-500">
        © {year} PraiaDigital. Todos os direitos reservados.
      </p>
      <p class="text-xs text-slate-400">
        Este site segue a LGPD. Seus dados são tratados conforme a Política de Privacidade.
      </p>
      <a href="#conteudo" class="text-sm font-medium text-slate-500 no-underline hover:text-brand-600">Voltar ao topo ↑</a>
    </div>
  </div>
</footer>
