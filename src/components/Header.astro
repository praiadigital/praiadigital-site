---
const base = import.meta.env.BASE_URL; // e.g. '/praiadigital-site/'
const whatsappNumber = import.meta.env.WHATSAPP_NUMBER ?? '5511954346288';
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
const pathname = Astro.url.pathname;

const u = (path: string) => `${base}${path.replace(/^\//, '')}`;

const servicos = [
  { href: u('/servicos/gestao-aluguel-temporada/'), label: 'Gestão de aluguel temporada' },
  { href: u('/servicos/assessoria-imobiliaria/'), label: 'Assessoria imobiliária' },
  { href: u('/servicos/zeladoria-manutencao/'), label: 'Zeladoria e manutenção' },
];

const navLinks = [
  { href: u('/sobre/'), label: 'Sobre' },
  { href: u('/servicos/'), label: 'Serviços' },
  { href: u('/hub/ia-corretores-litoral.html'), label: 'Hub IA' },
  { href: u('/blog/'), label: 'Conteúdos' },
  { href: u('/faq/'), label: 'FAQ' },
  { href: u('/contato/'), label: 'Contato' },
];

function isActive(href: string): boolean {
  const path = href.replace(base, '/');
  if (path.startsWith('/blog')) return pathname.includes('/blog');
  if (path.startsWith('/servicos')) return pathname.includes('/servicos');
  if (path.includes('/hub/')) return pathname.includes('/hub') || pathname.includes('/cidades');
  return pathname.endsWith(path);
}
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur border-b border-slate-200">
  <div class="container py-4 flex items-center justify-between">
    <a href={base} class="flex items-center gap-2 font-semibold text-brand-600 text-lg" aria-label="PraiaDigital — página inicial">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-brand-600 text-white" aria-hidden="true">P</span>
      <span>PraiaDigital</span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600" aria-label="Navegação principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={isActive(link.href) ? 'text-brand-600' : 'hover:text-brand-600'}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-md bg-litoral-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-litoral-500"
      >
        WhatsApp
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.6-5.2A8.38 8.38 0 0 1 3.5 11.5a8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/></svg>
      </a>

      <details class="relative md:hidden" id="mobile-menu">
        <summary class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-slate-300 text-slate-700 hover:border-slate-400" aria-label="Abrir menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </summary>
        <nav class="absolute right-0 top-12 w-64 rounded-xl border border-slate-200 bg-white p-4 shadow-lg" aria-label="Menu móvel">
          <ul class="space-y-1 text-sm font-medium text-slate-700">
            {navLinks.map((link) => (
              <li><a href={link.href} class="block rounded-md px-3 py-2 hover:bg-slate-50 hover:text-brand-600" aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
            ))}
            <li class="border-t border-slate-200 pt-2 mt-2"><p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Serviços</p></li>
            {servicos.map((s) => (
              <li><a href={s.href} class="block rounded-md px-3 py-2 hover:bg-slate-50 hover:text-brand-600">{s.label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
