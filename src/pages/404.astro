---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" description="A página que você procura não existe ou foi movida." noindex={true}>
  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="container py-24 text-center">
      <p class="text-6xl font-semibold text-brand-600">404</p>
      <h1 class="mt-4 text-2xl font-semibold">Página não encontrada</h1>
      <p class="mx-auto mt-3 max-w-md text-slate-600">O endereço pode ter mudado ou nunca existiu. Escolha um dos caminhos abaixo:</p>
      <div class="mx-auto mt-8 grid max-w-2xl grid-cols-1 gap-3 sm:grid-cols-3">
        <a href="/" class="card card-hover text-sm font-semibold text-slate-900 no-underline hover:no-underline">Página inicial</a>
        <a href="/servicos" class="card card-hover text-sm font-semibold text-slate-900 no-underline hover:no-underline">Nossos serviços</a>
        <a href="/contato" class="card card-hover text-sm font-semibold text-slate-900 no-underline hover:no-underline">Falar com a equipe</a>
      </div>
    </div>
  </section>
</BaseLayout>
