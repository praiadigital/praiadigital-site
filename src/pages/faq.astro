---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Como funciona o atendimento inicial?',
    a: 'Você preenche o formulário na página de contato ou envia mensagem pelo WhatsApp. Um especialista responde em até um dia útil.'
  },
  {
    q: 'Quais cidades atendem?',
    a: 'Atuamos no litoral norte de SP — São Sebastião, Ubatuba, Caraguatatuba e Ilhabela — com foco em temporada e venda de imóveis.'
  },
  {
    q: 'Os valores são personalizados?',
    a: 'Sim. Após um briefing gratuito, montamos proposta por serviço e escopo, sem compromisso.'
  },
  {
    q: 'Vocês cuidam do imóvel se eu morar em outra cidade?',
    a: 'Sim. A zeladoria local inclui inspeções periódicas com relatório fotográfico, manutenção preventiva e atendimento emergencial — você acompanha tudo à distância.'
  },
  {
    q: 'Como a IA é usada no atendimento?',
    a: 'Usamos IA para agilizar respostas no WhatsApp, qualificar leads, gerar conteúdo local e fazer follow-up — sempre com supervisão humana.'
  },
  {
    q: 'Posso cancelar quando quiser?',
    a: 'As condições de vigência e cancelamento são definidas de forma transparente na proposta, antes de qualquer contratação.'
  }
];
---

<BaseLayout title="Perguntas frequentes sobre gestão de imóveis no litoral norte de SP" description="Perguntas frequentes sobre os serviços da PraiaDigital: gestão de temporada, zeladoria, assessoria imobiliária e atendimento com IA no litoral norte de SP.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a }
    }))
  })} />

  <section class="border-b border-slate-200">
    <div class="container py-16">
      <h1 class="text-3xl font-semibold tracking-tight">Perguntas frequentes</h1>
      <p class="mt-4 max-w-2xl text-slate-600">Respostas rápidas para as dúvidas mais comuns de proprietários e imobiliárias.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <dl class="max-w-3xl divide-y divide-slate-200">
        {faqs.map((f) => (
          <div class="py-6">
            <dt class="text-base font-semibold text-slate-900">{f.q}</dt>
            <dd class="mt-2 text-sm text-slate-600">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="container py-12">
      <h2 class="text-xl font-semibold">Explore mais</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        <a href="/servicos/gestao-aluguel-temporada" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Gestão de temporada</p>
          <p class="mt-1 text-sm text-slate-600">Anúncios, reservas e precificação dinâmica.</p>
        </a>
        <a href="/blog/cases" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Cases e resultados</p>
          <p class="mt-1 text-sm text-slate-600">Resultados reais de clientes no litoral.</p>
        </a>
        <a href="/contato" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Fale com a equipe</p>
          <p class="mt-1 text-sm text-slate-600">Resposta em até 1 dia útil pelo WhatsApp.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
