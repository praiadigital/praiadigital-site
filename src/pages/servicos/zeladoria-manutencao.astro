---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
---

<BaseLayout title="Zeladoria e manutenção" description="Zeladoria, manutenção preventiva, suporte local e atendimento emergencial para imóveis no litoral norte de SP.">
  <section class="border-b border-slate-200">
    <div class="container py-16">
      <h1 class="text-3xl font-semibold tracking-tight">Seu imóvel sempre pronto, mesmo com você longe</h1>
      <p class="mt-2 text-sm font-semibold text-brand-600">Zeladoria e manutenção no litoral norte de SP</p>
      <p class="mt-4 max-w-2xl text-slate-600">
        Suporte local, inspeções, manutenção preventiva e atendimento emergencial para manter o imóvel sempre pronto para receber hóspedes ou compradores.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <article class="rounded-xl border border-slate-200 p-6">
          <h2 class="text-base font-semibold">Inspeção</h2>
          <p class="mt-2 text-sm text-slate-600">Verificação periódica com relatório fotográfico.</p>
        </article>
        <article class="rounded-xl border border-slate-200 p-6">
          <h2 class="text-base font-semibold">Preventiva</h2>
          <p class="mt-2 text-sm text-slate-600">Pintura, hidráulica, elétrica e telhado.</p>
        </article>
        <article class="rounded-xl border border-slate-200 p-6">
          <h2 class="text-base font-semibold">Emergencial</h2>
          <p class="mt-2 text-sm text-slate-600">Atendimento rápido 7 dias por semana.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="container py-12">
      <h2 class="text-xl font-semibold">Serviços relacionados</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        <a href="/servicos/gestao-aluguel-temporada" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Gestão de aluguel por temporada</p>
          <p class="mt-1 text-sm text-slate-600">Combine zeladoria com gestão completa de reservas e hóspedes.</p>
        </a>
        <a href="/servicos/assessoria-imobiliaria" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Assessoria imobiliária</p>
          <p class="mt-1 text-sm text-slate-600">Valorize o imóvel e conte com assessoria completa na venda.</p>
        </a>
        <a href="/contato" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Fale com a equipe</p>
          <p class="mt-1 text-sm text-slate-600">Solicite uma proposta de zeladoria para o seu imóvel.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200">
    <div class="container py-16">
      <LeadForm />
    </div>
  </section>
</BaseLayout>
