---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
---

<BaseLayout title="Contato" description="Fale com a PraiaDigital por WhatsApp ou formulário para imóveis no litoral norte de SP.">
  <section class="border-b border-slate-200">
    <div class="container py-16">
      <h1 class="text-3xl font-semibold tracking-tight">Vamos conversar sobre seu imóvel?</h1>
      <p class="mt-4 max-w-2xl text-slate-600">
        Conte seu objetivo — mais reservas, venda ou tranquilidade na manutenção. Respondemos em até 1 dia útil pelo WhatsApp.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a href="https://wa.me/5511954346288" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-md bg-litoral-600 px-4 py-3 text-sm font-semibold text-white shadow hover:bg-litoral-500">
          Chamar no WhatsApp
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.6-5.2A8.38 8.38 0 0 1 3.5 11.5a8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/></svg>
        </a>
        <a href="/faq" class="text-sm font-semibold text-slate-600 underline hover:text-brand-600">Ver perguntas frequentes</a>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container py-12">
      <h2 class="text-xl font-semibold">Como podemos ajudar</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        <a href="/servicos/gestao-aluguel-temporada" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Gestão de temporada</p>
          <p class="mt-1 text-sm text-slate-600">Mais reservas e receita com operação completa.</p>
        </a>
        <a href="/servicos/zeladoria-manutencao" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Zeladoria e manutenção</p>
          <p class="mt-1 text-sm text-slate-600">Imóvel sempre pronto, mesmo à distância.</p>
        </a>
        <a href="/servicos/assessoria-imobiliaria" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Assessoria imobiliária</p>
          <p class="mt-1 text-sm text-slate-600">Venda ou valorização com segurança.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <LeadForm />
    </div>
  </section>
</BaseLayout>
