---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Como funciona o atendimento inicial?',
    a: 'Você preenche o formulário de contato ou envia mensagem pelo WhatsApp. Um especialista responde em até um dia útil.',
  },
  {
    q: 'Quais cidades atendem?',
    a: 'Atuamos no litoral norte de SP — São Sebastião, Ubatuba, Caraguatatuba e Ilhabela — com foco em temporada e venda de imóveis.',
  },
  {
    q: 'Os valores são personalizados?',
    a: 'Sim. Após um briefing gratuito, montamos proposta por serviço e escopo, sem compromisso.',
  },
  {
    q: 'Vocês cuidam do imóvel se eu morar em outra cidade?',
    a: 'Sim. A zeladoria local inclui inspeções periódicas com relatório fotográfico, manutenção preventiva e atendimento emergencial — você acompanha tudo à distância.',
  },
  {
    q: 'Como a IA é usada no atendimento?',
    a: 'Usamos IA para agilizar respostas no WhatsApp, qualificar leads, gerar conteúdo local e fazer follow-up — sempre com supervisão humana.',
  },
  {
    q: 'Posso cancelar quando quiser?',
    a: 'As condições de vigência e cancelamento são definidas de forma transparente na proposta, antes de qualquer contratação.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout title="FAQ" description="Perguntas frequentes sobre serviços da PraiaDigital para imóveis no litoral norte de SP.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <section class="border-b border-slate-200">
    <div class="container py-16">
      <h1 class="text-3xl font-semibold tracking-tight">Perguntas frequentes</h1>
      <p class="mt-4 max-w-2xl text-slate-600">Respostas rápidas para as dúvidas mais comuns de proprietários e imobiliárias.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <dl class="max-w-3xl divide-y divide-slate-200">
        <div class="py-6">
          <dt class="text-base font-semibold text-slate-900">Como funciona o atendimento inicial?</dt>
          <dd class="mt-2 text-sm text-slate-600">Você preenche o <a href="/contato" class="text-brand-600 underline hover:text-brand-700">formulário de contato</a> ou envia mensagem pelo WhatsApp. Um especialista responde em até um dia útil.</dd>
        </div>
        <div class="py-6">
          <dt class="text-base font-semibold text-slate-900">Quais cidades atendem?</dt>
          <dd class="mt-2 text-sm text-slate-600">Atuamos no litoral norte de SP — São Sebastião, Ubatuba, Caraguatatuba e Ilhabela — com foco em temporada e venda de imóveis. Veja as <a href="/hub/ia-corretores-litoral.html" class="text-brand-600 underline hover:text-brand-700">ferramentas por cidade</a>.</dd>
        </div>
        <div class="py-6">
          <dt class="text-base font-semibold text-slate-900">Os valores são personalizados?</dt>
          <dd class="mt-2 text-sm text-slate-600">Sim. Após um briefing gratuito, montamos proposta por serviço e escopo, sem compromisso.</dd>
        </div>
        <div class="py-6">
          <dt class="text-base font-semibold text-slate-900">Vocês cuidam do imóvel se eu morar em outra cidade?</dt>
          <dd class="mt-2 text-sm text-slate-600">Sim. A <a href="/servicos/zeladoria-manutencao" class="text-brand-600 underline hover:text-brand-700">zeladoria local</a> inclui inspeções periódicas com relatório fotográfico, manutenção preventiva e atendimento emergencial — você acompanha tudo à distância.</dd>
        </div>
        <div class="py-6">
          <dt class="text-base font-semibold text-slate-900">Como a IA é usada no atendimento?</dt>
          <dd class="mt-2 text-sm text-slate-600">Usamos IA para agilizar respostas no WhatsApp, qualificar leads, gerar conteúdo local e fazer follow-up — sempre com supervisão humana. Conheça o <a href="/hub/ia-corretores-litoral.html" class="text-brand-600 underline hover:text-brand-700">hub de IA para corretores</a> e o artigo sobre <a href="/blog/ia-para-corretores-litoral" class="text-brand-600 underline hover:text-brand-700">IA para corretores do litoral</a>.</dd>
        </div>
        <div class="py-6">
          <dt class="text-base font-semibold text-slate-900">Posso cancelar quando quiser?</dt>
          <dd class="mt-2 text-sm text-slate-600">As condições de vigência e cancelamento são definidas de forma transparente na proposta, antes de qualquer contratação.</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
