---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Assessoria imobiliária',
  description: 'Assessoria para venda e temporada: avaliação, documentação, negociação e captação qualificada no litoral norte de SP.',
  provider: { '@type': 'Organization', name: 'PraiaDigital', url: 'https://praia.digital' },
  areaServed: ['Ubatuba', 'Caraguatatuba', 'São Sebastião', 'Ilhabela'],
  url: 'https://praia.digital/servicos/assessoria-imobiliaria',
};
---

<BaseLayout title="Assessoria imobiliária" description="Assessoria para venda e temporada: avaliação, documentação, negociação e captação qualificada no litoral norte de SP.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />

  <section class="border-b border-slate-200">
    <div class="container py-16">
      <h1 class="text-3xl font-semibold tracking-tight">Venda ou valorize seu imóvel com segurança do início ao fim</h1>
      <p class="mt-2 text-sm font-semibold text-brand-600">Assessoria imobiliária no litoral norte de SP</p>
      <p class="mt-4 max-w-2xl text-slate-600">
        Orientação na venda, documentação, avaliação de valor e captação qualificada de compradores e investidores no litoral norte de São Paulo.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <article class="rounded-xl border border-slate-200 p-6">
          <h2 class="text-base font-semibold">Avaliação</h2>
          <p class="mt-2 text-sm text-slate-600">Análise de valor de mercado por região e padrão.</p>
        </article>
        <article class="rounded-xl border border-slate-200 p-6">
          <h2 class="text-base font-semibold">Documentação</h2>
          <p class="mt-2 text-sm text-slate-600">Checklist para escritura, registro e transferência.</p>
        </article>
        <article class="rounded-xl border border-slate-200 p-6">
          <h2 class="text-base font-semibold">Negociação</h2>
          <p class="mt-2 text-sm text-slate-600">Acompanhamento para condições seguras e claras.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="container py-12">
      <h2 class="text-xl font-semibold">Serviços relacionados</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        <a href="/servicos/gestao-aluguel-temporada" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Gestão de aluguel por temporada</p>
          <p class="mt-1 text-sm text-slate-600">Gere renda com o imóvel enquanto decide pela venda.</p>
        </a>
        <a href="/servicos/zeladoria-manutencao" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Zeladoria e manutenção</p>
          <p class="mt-1 text-sm text-slate-600">Mantenha o imóvel valorizado com inspeções e prevenção.</p>
        </a>
        <a href="/faq" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Perguntas frequentes</p>
          <p class="mt-1 text-sm text-slate-600">Tire dúvidas sobre venda, documentação e prazos.</p>
        </a>
      </div>
      <p class="mt-6 text-sm text-slate-600">Leia também: <a href="/blog/palavras-chave-seo-litoral" class="text-brand-600 underline hover:text-brand-700">palavras-chave que geram vendas no litoral</a>.</p>
    </div>
  </section>

  <section class="border-t border-slate-200">
    <div class="container py-16">
      <LeadForm />
    </div>
  </section>
</BaseLayout>
