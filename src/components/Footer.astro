---
import { cidades } from '../data/cidades';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const u = (path: string) => `${base}${path.replace(/^\//, '')}`;

---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="container py-12">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-5">
      <div>
        <p class="font-semibold text-slate-900">PraiaDigital</p>
        <p class="mt-2 text-sm text-slate-600">
          Inbound Marketing para imóveis no litoral norte de São Paulo.
        </p>
        <p class="mt-4 text-sm text-slate-600">
          E-mail: <a href="mailto:comercial@praia.digital" class="underline">comercial@praia.digital</a>
        </p>
      </div>

      <nav aria-label="Serviços">
        <p class="font-semibold text-slate-900">Serviços</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li><a href={u('/servicos/')} class="hover:text-brand-600">Todos os serviços</a></li>
          <li><a href={u('/servicos/gestao-aluguel-temporada/')} class="hover:text-brand-600">Gestão de aluguel temporada</a></li>
          <li><a href={u('/servicos/zeladoria-manutencao/')} class="hover:text-brand-600">Zeladoria e manutenção</a></li>
          <li><a href={u('/servicos/assessoria-imobiliaria/')} class="hover:text-brand-600">Assessoria imobiliária</a></li>
        </ul>
      </nav>

      <nav aria-label="Cidades atendidas">
        <p class="font-semibold text-slate-900">Cidades</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          {cidades.map((cidade) => (
            <li><a href={u(`/cidades/${cidade.slug}/`)} class="hover:text-brand-600">{cidade.nome}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Conteúdos e recursos">
        <p class="font-semibold text-slate-900">Conteúdos</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li><a href={u('/blog/')} class="hover:text-brand-600">Blog</a></li>
          <li><a href={u('/blog/como-preparar-imovel-temporada/')} class="hover:text-brand-600">Preparar o imóvel para temporada</a></li>
          <li><a href={u('/blog/fotos-que-vendem-mais/')} class="hover:text-brand-600">Fotos que vendem mais</a></li>
          <li><a href={u('/blog/palavras-chave-seo-litoral/')} class="hover:text-brand-600">Palavras-chave para o litoral</a></li>
          <li><a href={u('/blog/ia-para-corretores-litoral/')} class="hover:text-brand-600">IA para corretores</a></li>
          <li><a href={u('/hub/ia-corretores-litoral.html')} class="hover:text-brand-600">Hub de IA para corretores</a></li>
          <li><a href={u('/blog/cases/')} class="hover:text-brand-600">Cases</a></li>
        </ul>
      </nav>

      <nav aria-label="Institucional">
        <p class="font-semibold text-slate-900">Institucional</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li><a href={u('/sobre/')} class="hover:text-brand-600">Sobre</a></li>
          <li><a href={u('/faq/')} class="hover:text-brand-600">FAQ</a></li>
          <li><a href={u('/contato/')} class="hover:text-brand-600">Contato</a></li>
          <li><a href={u('/privacidade/')} class="hover:text-brand-600">Política de Privacidade</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-slate-200 pt-6 md:flex-row md:items-center md:justify-between">
      <p class="text-sm text-slate-500">
        © {year} PraiaDigital. Todos os direitos reservados.
      </p>
      <p class="text-xs text-slate-400">
        Este site segue a LGPD. Seus dados são tratados conforme a Política de Privacidade.
      </p>
    </div>
  </div>
</footer>
