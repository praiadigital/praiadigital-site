---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { cidades, cidadePorSlug } from '../../data/cidades.ts';

export function getStaticPaths() {
  return cidades.map((cidade) => ({ params: { slug: cidade.slug } }));
}

const { slug } = Astro.params;
const cidade = cidadePorSlug(slug);

if (!cidade) {
  return Astro.redirect('/404');
}

const contextos: Record<string, string> = {
  'sao-sebastiao': 'São Sebastião combina praias urbanas e vilas charmosas como Maresias e Juquehy, com forte demanda de temporada no verão e público de alto padrão o ano todo.',
  'ubatuba': 'Ubatuba tem mais de 100 praias e um mercado de temporada aquecido, com busca constante por casas e apartamentos perto do mar — do Itaguá ao norte do município.',
  'caraguatatuba': 'Caraguatatuba é a maior cidade do litoral norte, com mercado imobiliário ativo tanto para temporada quanto para moradia e investimento.',
  'ilhabela': 'Ilhabela é o destino premium do litoral norte: imóveis de alto padrão, náutica forte e público que valoriza exclusividade e boa apresentação do anúncio.',
};

const contexto = contextos[cidade.slug] ?? `Conteúdo e estratégias locais para o mercado imobiliário de ${cidade.nome}.`;

const outrasCidades = cidades.filter((c) => c.slug !== cidade.slug);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://praia.digital/' },
    { '@type': 'ListItem', position: 2, name: 'Cidades', item: 'https://praia.digital/cidades' },
    { '@type': 'ListItem', position: 3, name: cidade.nome, item: `https://praia.digital/cidades/${cidade.slug}` },
  ],
};
---

<BaseLayout title={cidade.metaTitle} description={cidade.metaDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container py-16 md:py-24">
      <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-600">Home</a>
        <span aria-hidden="true"> / </span>
        <a href="/hub/ia-corretores-litoral.html" class="hover:text-brand-600">Cidades</a>
        <span aria-hidden="true"> / </span>
        <span class="text-slate-700">{cidade.nome}</span>
      </nav>
      <div class="mt-6 max-w-2xl">
        <p class="text-sm font-semibold text-brand-600">Litoral {cidade.regiao} de SP</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">Imóveis em {cidade.nome} com estratégia local</h1>
        <p class="mt-4 text-lg text-slate-600">{contexto}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contato" class="rounded-md bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow hover:bg-brand-700">Falar com especialista local</a>
          <a href="/servicos" class="rounded-md border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:border-slate-400">Ver serviços</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <h2 class="text-2xl font-semibold">O que fazemos em {cidade.nome}</h2>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
        <a href="/servicos/gestao-aluguel-temporada" class="rounded-xl border border-slate-200 p-6 hover:border-slate-300">
          <h3 class="text-base font-semibold">Gestão de temporada</h3>
          <p class="mt-2 text-sm text-slate-600">Anúncios, reservas e precificação para o mercado de {cidade.nome}.</p>
        </a>
        <a href="/servicos/assessoria-imobiliaria" class="rounded-xl border border-slate-200 p-6 hover:border-slate-300">
          <h3 class="text-base font-semibold">Assessoria imobiliária</h3>
          <p class="mt-2 text-sm text-slate-600">Avaliação e venda com leitura local de preços e demanda.</p>
        </a>
        <a href="/servicos/zeladoria-manutencao" class="rounded-xl border border-slate-200 p-6 hover:border-slate-300">
          <h3 class="text-base font-semibold">Zeladoria e manutenção</h3>
          <p class="mt-2 text-sm text-slate-600">Inspeções e manutenção preventiva com equipe local.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="container py-12">
      <h2 class="text-xl font-semibold">Conteúdos para {cidade.nome}</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        <a href="/blog/como-preparar-imovel-temporada" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Preparar o imóvel para temporada</p>
          <p class="mt-1 text-sm text-slate-600">Checklist completo antes de anunciar.</p>
        </a>
        <a href="/blog/palavras-chave-seo-litoral" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Palavras-chave para o litoral</p>
          <p class="mt-1 text-sm text-slate-600">As buscas que trazem clientes para {cidade.nome}.</p>
        </a>
        <a href="/hub/ia-corretores-litoral.html" class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300">
          <p class="text-sm font-semibold text-slate-900">Hub de IA para corretores</p>
          <p class="mt-1 text-sm text-slate-600">Prompts e automações para o mercado local.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200">
    <div class="container py-12">
      <h2 class="text-xl font-semibold">Outras cidades atendidas</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        {outrasCidades.map((outra) => (
          <a href={`/cidades/${outra.slug}`} class="rounded-xl border border-slate-200 p-5 hover:border-slate-300">
            <p class="text-sm font-semibold text-brand-600">Litoral {outra.regiao}</p>
            <p class="mt-1 text-base font-semibold text-slate-900">{outra.nome}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200">
    <div class="container py-16">
      <LeadForm />
    </div>
  </section>
</BaseLayout>
