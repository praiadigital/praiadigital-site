---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Cases — PraiaDigital';
const description = 'Cases e resultados de inbound marketing, automação e gestão de aluguel temporada no litoral norte de São Paulo.';
const canonical = 'https://praia.digital/blog/cases.html';
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container py-16 md:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-brand-600">Resultados reais</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">Cases</h1>
        <p class="mt-4 text-lg text-slate-600">{description}</p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <article class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-semibold text-brand-600">Aluguel temporada</p>
          <h2 class="mt-2 text-lg font-semibold">Imóvel em São Sebastião</h2>
          <p class="mt-2 text-sm text-slate-600"><strong class="text-slate-900">Desafio:</strong> imóvel de temporada com baixa visibilidade fora dos portais.</p>
          <p class="mt-2 text-sm text-slate-600"><strong class="text-slate-900">Ação:</strong> conteúdo local otimizado para busca + automação de atendimento.</p>
          <p class="mt-2 text-sm text-slate-600"><strong class="text-slate-900">Resultado:</strong> aumento de 3,2x nas visitas orgânicas locais em 30 dias.</p>
          <p class="mt-4 text-sm"><a href="/servicos/gestao-aluguel-temporada" class="font-semibold text-brand-600 underline hover:text-brand-700">Conheça a gestão de temporada →</a></p>
        </article>
        <article class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-semibold text-brand-600">Assessoria</p>
          <h2 class="mt-2 text-lg font-semibold">Imobiliária em Ubatuba</h2>
          <p class="mt-2 text-sm text-slate-600"><strong class="text-slate-900">Desafio:</strong> dependência total de portais para geração de leads.</p>
          <p class="mt-2 text-sm text-slate-600"><strong class="text-slate-900">Ação:</strong> conteúdo local + automação de WhatsApp para qualificação.</p>
          <p class="mt-2 text-sm text-slate-600"><strong class="text-slate-900">Resultado:</strong> +170 leads qualificados em 30 dias.</p>
          <p class="mt-4 text-sm"><a href="/servicos/assessoria-imobiliaria" class="font-semibold text-brand-600 underline hover:text-brand-700">Conheça a assessoria imobiliária →</a></p>
        </article>
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="https://wa.me/5511954346288" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-md bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow hover:bg-brand-700">
          Quero um resultado assim
        </a>
        <a href="/blog" class="text-sm font-semibold text-slate-600 underline hover:text-brand-600">Ver conteúdos do blog</a>
        <a href="/faq" class="text-sm font-semibold text-slate-600 underline hover:text-brand-600">Perguntas frequentes</a>
      </div>
    </div>
  </section>
</BaseLayout>
